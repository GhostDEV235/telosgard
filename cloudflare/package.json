{
  "name": "telosgard-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply telosgard --local",
    "db:remote": "wrangler d1 migrations apply telosgard --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "better-auth": "1.7.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261027.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "fsevents": false
  }
}
